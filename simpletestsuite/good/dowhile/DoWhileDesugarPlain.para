// Differential test: this is DoWhilePlain with the do-while replaced by its
// desugaring -- one copy of the body, then an equivalent while loop.
// The two files must agree. See DoWhilePlain.para for what that establishes.
public class DoWhileDesugarPlain {
  public int f() {
    int i = 0;
    {
      i = i + 1;
    }
    while (i < 3) {
      i = i + 1;
    }
    return i;
  }
}
